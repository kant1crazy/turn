# Clé API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Dossier de stockage des photos brutes/générées par article
DATA_DIR=./data

# Chemin du classeur Excel (prix d'achat / prix conseillé)
EXCEL_PATH=./data/articles.xlsx

# Multiplicateur de marge par défaut appliqué au prix d'achat
# quand la case "utiliser le prix marché" n'est pas cochée
DEFAULT_MARGIN_MULTIPLIER=2.2

# Nombre max de résultats à récupérer lors d'une estimation de marché
SCRAPER_MAX_RESULTS=30

# Délai (secondes) entre deux requêtes au scraper Vinted
SCRAPER_DELAY_SECONDS=1.5
