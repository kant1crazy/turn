        { "id": "bottle.a", "text": "En [CM1,|cé ème un,] / tu lançais / ta bouteille d'eau / jusqu'à ce qu'elle / retombe debout.", "gap": 0.3 },
        { "id": "bottle.b", "text": "Même pendant / le repas." }
