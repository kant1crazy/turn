      "lines": [
        { "id": "portable.a", "text": "Le jour où / t'es entré / au collège, / le téléphone / y a été / interdit / par la loi.", "gap": 0.3 },
        { "id": "portable.b", "text": "Le tien / a fini éteint, / au fond du sac." }
