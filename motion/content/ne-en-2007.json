      "lines": [
        { "id": "euro.a", "text": "L'été de / tes neuf ans, / la France / a perdu / la finale / de l'Euro, / à la maison.", "gap": 0.3 },
        { "id": "euro.b", "text": "Un seul but, / en prolongation." }
      ],
      "sfx": [
        { "name": "impact", "at": "euro.a#perdu", "gain": 0.7 },
