  "scenes": [
    {
      "id": "hook",
      "lines": [
        { "id": "hook.a", "text": "Si t'es né / en [2007,|deux mille sept,] / compte un point / à chaque fois / que c'est vrai." },
        { "id": "hook.b", "text": "À moins de cinq, / t'as menti / sur ton âge." }
