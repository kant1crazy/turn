      "lines": [
        { "id": "punch.a", "text": "Mais avant, / le dernier.", "gap": 0.22 },
        { "id": "punch.b", "text": "Et celui-là, / il pique.", "gap": 0.5 },
        { "id": "punch.c", "kind": "reveal", "text": "L'année prochaine, / t'as / vingt [ans.|ans !]", "gap": 0.45 },
        { "id": "punch.d", "text": "Et ça fait / bizarre, / surtout…", "gap": 0.0 }
