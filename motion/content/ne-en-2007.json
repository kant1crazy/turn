        { "name": "stamp", "at": "hook.b#menti" }
      ]
    },
    {
      "id": "loom",
      "point": { "at": "loom.c#famille", "offset": 0.3 },
      "lines": [
        { "id": "loom.a", "kind": "riddle", "text": "En [CP,|cé pé,] / t'en avais / jusqu'au coude, / de toutes / les couleurs…" },
        { "id": "loom.b", "kind": "reveal", "text": "Les bracelets / en élastiques." },
        { "id": "loom.c", "text": "Et t'en as offert / à toute / ta famille." }
