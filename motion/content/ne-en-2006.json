      "id": "punch",
      "lines": [
        { "id": "punch.a", "text": "Mais avant, / le dernier.", "gap": 0.22 },
        { "id": "punch.b", "text": "Celui qui / fait mal.", "gap": 0.5 },
        { "id": "punch.c", "kind": "reveal", "text": "Pokémon [GO,|go,] / c'était il y a / dix [ans.|ans !]", "gap": 0.45 },
