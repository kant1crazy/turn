      "lines": [
        { "id": "mondial.a", "kind": "riddle", "text": "L'été suivant, / tout le monde / est sorti / dans la rue / en hurlant…" },
        { "id": "mondial.b", "kind": "reveal", "text": "La France / championne / du monde." },
        { "id": "mondial.c", "text": "Et t'as crié / comme si / t'avais marqué." }
      ]
    },
    {
      "id": "relance",
      "lines": [
        { "id": "relance.a", "text": "Jusque-là, c'était / facile." },
        { "id": "relance.b", "text": "Les quatre suivants, / c'est là / que ça se joue." }
