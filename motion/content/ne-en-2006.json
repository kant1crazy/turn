    {
      "id": "pokemon",
      "point": { "at": "pokemon.b#batterie", "offset": 0.3 },
      "lines": [
        { "id": "pokemon.a", "text": "L'été d'avant, / tu passais / tes journées / sur le téléphone / de ta mère, / à jouer à / Pokémon [GO.|go.]", "gap": 0.28 },
        { "id": "pokemon.b", "text": "Tu lui rendais / à [2 %|deux pour cent] / de batterie." }
