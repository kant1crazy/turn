      "point": { "at": "spinner.d" },
      "lines": [
        { "id": "spinner.a", "kind": "riddle", "text": "En [CM2,|cé ème deux,] / t'avais toujours / un truc qui tournait / entre tes doigts…" },
        { "id": "spinner.b", "kind": "reveal", "text": "Le [hand|hannd] [spinner.|spineur.]" },
        { "id": "spinner.c", "text": "Ne mens pas." },
        { "id": "spinner.d", "text": "Et un point." }
      ]
